[Unit]
Description=WPSD Wi-Fi Manager Watchdog
Wants=network-online.target
After=network-online.target NetworkManager.service

[Service]
Type=simple
User=pi-star
Group=pi-star
WorkingDirectory=/opt/wpsd-wifi-manager
Environment=PYTHONPATH=/opt/wpsd-wifi-manager/src
ExecStart=/usr/bin/python3 -m wpsd_wifi_manager.watchdog --config /opt/wpsd-wifi-manager/config/config.json --helper-command "sudo -n /opt/wpsd-wifi-manager/bin/wifi-helper" --log-path /opt/wpsd-wifi-manager/logs/wifi-manager.log --log-level INFO
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
